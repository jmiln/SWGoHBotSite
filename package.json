{
    "name": "SWGoHBotSite",
    "version": "2.3.0",
    "type": "module",
    "main": "server.ts",
    "description": "",
    "scripts": {
        "prepare": "husky",
        "setup": "npm install && npm run prepare",
        "start": "node --env-file=.env server.ts",
        "dev": "node --env-file=.env --watch server.ts",
        "lint": "biome check --no-errors-on-unmatched .",
        "lint:write": "biome check --write --no-errors-on-unmatched .",
        "typecheck": "tsc --noEmit",
        "test": "LOG_LEVEL=silent node --test --test-global-setup ./test/setup/globalSetup.ts './test/**/*.test.ts'",
        "changelog:draft": "scripts/changelog-draft.sh",
        "changelog:write": "scripts/changelog-draft.sh --write",
        "changelog:release": "scripts/changelog-draft.sh --write --release",
        "release": "npm version --ignore-scripts=false",
        "version": "scripts/changelog-draft.sh --write --stage --release $npm_package_version"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jmiln/SWGoHBotSite.git"
    },
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/jmiln/SWGoHBotSite/issues"
    },
    "homepage": "https://github.com/jmiln/SWGoHBotSite#readme",
    "engines": {
        "node": ">=26"
    },
    "dependencies": {
        "connect-mongo": "^6.0.0",
        "ejs": "^7.0.1",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "express-session": "^1.19.0",
        "helmet": "^8.3.0",
        "mongodb": "^7.7.0",
        "pino": "^10.4.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@testcontainers/mongodb": "^12.2.0",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.19.0",
        "husky": "^9.1.7",
        "typescript": "^7.0.2"
    }
}
